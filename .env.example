# Root environment. Run `pnpm env:sync` after editing to write per-app files.
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable (or legacy anon) key. Safe to ship in the web app and extension.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Postgres connection for migrations and RLS tests (never shipped).
SUPABASE_DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Web app origin. A deployed https origin is also the only page the production
# extension build trusts (WXT_WEB_ORIGINS); loopback origins are for local builds.
WEB_ORIGIN=http://localhost:3000
# Team support address, linked from Help, Privacy and the accessibility statement.
# Required for a production web build; development falls back to the issue tracker.
CONTACT_EMAIL=
# Unpacked dev build id (fixed by the dev key in apps/extension/wxt.config.ts).
EXTENSION_ID=bbnblnlbgcccbbbbihngngbecbobedie
