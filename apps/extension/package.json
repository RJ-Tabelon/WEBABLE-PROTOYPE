    "typecheck": "tsc --noEmit",
    "zip": "wxt zip"
  },
  "dependencies": {
    "@webable/shared": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1",
    "vite": "^8.3.0",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
