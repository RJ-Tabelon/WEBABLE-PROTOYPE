{
  "name": "webable",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "brand:generate": "pnpm --filter @webable/server exec tsx ../../scripts/brand/generate.ts",
    "dev:server": "pnpm --filter @webable/server dev",
    "dev:ext": "pnpm --filter @webable/extension dev",
    "build": "pnpm -r build",
    "pages": "pnpm --filter @webable/extension build && node scripts/pages/build.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "eval": "node scripts/eval/run.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "@types/node": "26.6.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "spawn-sync"
    ]
  }
}
