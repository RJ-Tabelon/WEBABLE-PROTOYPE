{
  "name": "webable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter @webable/web run --if-present build",
    "build:functions": "node scripts/build-functions.mjs",
    "deploy:functions": "node scripts/deploy-functions.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:functions && pnpm build:functions --check && pnpm --filter @webable/tokens contrast && pnpm extension:validate",
    "dev": "pnpm --filter @webable/web dev",
    "dev:web": "pnpm --filter @webable/web dev",
    "dev:extension": "pnpm --filter @webable/extension dev",
    "env:sync": "node scripts/sync-env.mjs",
    "extension:check": "node scripts/check-extension-package.mjs",
    "extension:enable": "pnpm --filter @webable/extension exec wxt build --mode development && node scripts/enable-extension.mjs --open",
    "extension:release": "pnpm --filter @webable/extension build && pnpm extension:check",
    "extension:validate": "WXT_WEB_ORIGINS=https://webable.invalid/* WXT_WEB_ORIGIN=https://webable.invalid pnpm --filter @webable/extension exec wxt build --mode package-check && node scripts/check-extension-package.mjs apps/extension/.output/chrome-mv3-package-check",
    "extension:path": "node scripts/enable-extension.mjs",
    "db:push": "node scripts/db-push.mjs",
    "db:test": "node supabase/tests/run.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "pnpm --filter @webable/extension test:e2e && pnpm --filter @webable/web test:e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm check && pnpm test:e2e",
    "test:functions": "node supabase/tests/deno-test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.44.0",
    "esbuild": "0.28.2",
    "pg": "^8.16.3",
    "dotenv": "^17.2.3"
  }
}
